<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">

  <modelVersion>4.0.0</modelVersion>

  <groupId>dev.vsviniciuslima</groupId>
  <artifactId>camel-openapi-integration</artifactId>
  <packaging>jar</packaging>
  <version>1.1.0-SNAPSHOT</version>

  <name>A Camel Spring Boot Route</name>

  <properties>
    <java.version>17</java.version>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
    <spring.boot-version>3.3.7</spring.boot-version>
    <surefire.plugin.version>3.0.0-M7</surefire.plugin.version>
    <camel.version>4.4.3</camel.version>
  </properties>

  <dependencyManagement>

    <dependencies>
    <!--    camel api e camel support-->

      <dependency>
        <groupId>org.apache.camel</groupId>
        <artifactId>camel-api</artifactId>
      </dependency>
      <dependency>
        <groupId>org.apache.camel</groupId>
        <artifactId>camel-support</artifactId>
      </dependency>
      <dependency>
        <groupId>org.apache.camel</groupId>
        <artifactId>camel-endpointdsl</artifactId>
      </dependency>
      <!-- Spring Boot BOM -->
      <dependency>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-dependencies</artifactId>
        <version>${spring.boot-version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <!-- Camel BOM -->
      <dependency>
        <groupId>org.apache.camel.springboot</groupId>
        <artifactId>camel-spring-boot-bom</artifactId>
        <version>${camel.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>

    <dependency>
      <groupId>javax.annotation</groupId>
      <artifactId>javax.annotation-api</artifactId>
      <version>1.2</version>
    </dependency>

    <!-- Camel Endpoint DSL -->
    <dependency>
      <groupId>org.apache.camel</groupId>
      <artifactId>camel-endpointdsl</artifactId>
      <version>${camel.version}</version>
    </dependency>

      <!-- Camel Jackson para processamento JSON -->
      <dependency>
          <groupId>org.apache.camel.springboot</groupId>
          <artifactId>camel-jackson-starter</artifactId>
      </dependency>

    <!-- https://mvnrepository.com/artifact/org.projectlombok/lombok -->
    <dependency>
      <groupId>org.projectlombok</groupId>
      <artifactId>lombok</artifactId>
      <version>1.18.38</version>
    </dependency>

    <dependency>
      <groupId>org.apache.camel.springboot</groupId>
      <artifactId>camel-http-starter</artifactId>
    </dependency>

    <!-- Force Camel Support version to avoid conflicts -->
    <dependency>
      <groupId>org.apache.camel</groupId>
      <artifactId>camel-support</artifactId>
      <version>${camel.version}</version>
    </dependency>

    <!-- Spring Boot -->

    <dependency>
      <groupId>org.apache.camel.springboot</groupId>
      <artifactId>camel-servlet-starter</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
      <exclusions>
        <exclusion>
          <groupId>org.springframework.boot</groupId>
          <artifactId>spring-boot-starter-tomcat</artifactId>
        </exclusion>
      </exclusions>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-undertow</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-actuator</artifactId>
    </dependency>

    <!-- Jakarta EE API -->
    <dependency>
      <groupId>jakarta.annotation</groupId>
      <artifactId>jakarta.annotation-api</artifactId>
    </dependency>

    <!-- OpenAPI Jackson Nullable -->
    <dependency>
      <groupId>org.openapitools</groupId>
      <artifactId>jackson-databind-nullable</artifactId>
      <version>0.2.6</version>
    </dependency>
    <!-- Jackson dependencies managed by Spring Boot -->
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
    </dependency>
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-core</artifactId>
    </dependency>
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-annotations</artifactId>
    </dependency>
    <dependency>
      <groupId>com.fasterxml.jackson.datatype</groupId>
      <artifactId>jackson-datatype-jsr310</artifactId>
    </dependency>
    <!-- Camel -->
    <dependency>
      <groupId>org.apache.camel.springboot</groupId>
      <artifactId>camel-spring-boot-starter</artifactId>
    </dependency>
    <dependency>
      <groupId>org.apache.camel.springboot</groupId>
      <artifactId>camel-stream-starter</artifactId>
    </dependency>
    <dependency>
      <groupId>org.apache.camel.springboot</groupId>
      <artifactId>camel-rest-starter</artifactId>
    </dependency>

    <!-- Test -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.apache.camel</groupId>
      <artifactId>camel-test-spring-junit5</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- JUnit 5 (Jupiter) dependencies -->
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter-api</artifactId>
      <version>5.10.0</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter-engine</artifactId>
      <version>5.10.0</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.junit.platform</groupId>
      <artifactId>junit-platform-launcher</artifactId>
      <version>1.10.0</version>
      <scope>test</scope>
    </dependency>

      <!-- outras -->
      <!-- https://mvnrepository.com/artifact/com.squareup.okhttp3/okhttp -->
      <dependency>
          <groupId>com.squareup.okhttp3</groupId>
          <artifactId>okhttp</artifactId>
          <version>5.0.0-alpha.14</version>
      </dependency>

      <!-- Camel OpenAPI -->
      <dependency>
          <groupId>org.apache.camel.springboot</groupId>
          <artifactId>camel-openapi-java-starter</artifactId>
      </dependency>

<!--      &lt;!&ndash; OpenAPI Generator para criar modelos a partir das especificações &ndash;&gt;-->
<!--      <dependency>-->
<!--          <groupId>org.openapitools</groupId>-->
<!--          <artifactId>openapi-generator-maven-plugin</artifactId>-->
<!--          <version>6.2.1</version>-->
<!--          <scope>provided</scope>-->
<!--      </dependency>-->

<!--    ja vem do camel-spring-boot-starter-->
<!--      &lt;!&ndash; https://mvnrepository.com/artifact/org.apache.camel/camel-rest-starter &ndash;&gt;-->
<!--      <dependency>-->
<!--          <groupId>org.apache.camel</groupId>-->
<!--          <artifactId>camel-rest-starter</artifactId>-->
<!--          <version>3.0.0-RC3</version>-->
<!--      </dependency>-->

      <!-- Utilitários -->
      <dependency>
          <groupId>commons-io</groupId>
          <artifactId>commons-io</artifactId>
          <version>2.11.0</version>
      </dependency>

      <!-- https://mvnrepository.com/artifact/com.google.code.gson/gson -->
      <dependency>
          <groupId>com.google.code.gson</groupId>
          <artifactId>gson</artifactId>
          <version>2.12.1</version>
      </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.11.0</version>
        <configuration>
          <release>17</release>
        </configuration>
        <executions>
          <execution>
            <id>recompile</id>
            <goals>
              <goal>compile</goal>
            </goals>
            <phase>process-classes</phase>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
        <version>${spring.boot-version}</version>
        <executions>
          <execution>
            <goals>
              <goal>repackage</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>${surefire.plugin.version}</version>
      </plugin>
      <plugin>
        <groupId>org.openapitools</groupId>
        <artifactId>openapi-generator-maven-plugin</artifactId>
        <version>7.13.0</version>
        <executions>
          <execution>
            <id>generate-openapi-client</id>
            <goals>
              <goal>generate</goal>
            </goals>
            <configuration>
              <templateResourcePath>${project.basedir}/src/templates</templateResourcePath>

              <skip>false</skip>
              <skipValidateSpec>true</skipValidateSpec>
              <inputSpec>${project.basedir}/src/main/resources/api-core.yaml</inputSpec>
              <generatorName>java</generatorName>
              <library>resttemplate</library>
              <generateApiTests>false</generateApiTests>
              <generateModelTests>false</generateModelTests>
              <generateApiDocumentation>false</generateApiDocumentation>
              <generateModelDocumentation>false</generateModelDocumentation>

              <configOptions>

                <!-- Lombok para código limpo -->
                <useLombok>true</useLombok>

                <!-- Spring Boot 3 + Jakarta EE -->
                <useSpringBoot3>true</useSpringBoot3>
                <useJakartaEe>true</useJakartaEe>

                <!-- Java 8 Date/Time API -->
                <dateLibrary>java8</dateLibrary>

                <!-- Pacotes -->
                <apiPackage>dev.vsviniciuslima.client.api</apiPackage>
                <modelPackage>dev.vsviniciuslima.client.model</modelPackage>
                <invokerPackage>dev.vsviniciuslima.client</invokerPackage>

                <!-- Melhorias de legibilidade -->
                <hideGenerationTimestamp>true</hideGenerationTimestamp>
                <serializableModel>true</serializableModel>
                <withXml>false</withXml>

                <!-- Anotações Lombok nos Models -->
                <additionalModelTypeAnnotations>
                  @lombok.Builder @lombok.AllArgsConstructor
                </additionalModelTypeAnnotations>

                <generateModelTests>false</generateModelTests>

              </configOptions>
              <output>${project.build.directory}/generated-sources/core-client</output>
            </configuration>
          </execution>
          <execution>
            <id>generate-openapi-server</id>
            <goals>
              <goal>generate</goal>
            </goals>
            <configuration>
              <configHelp>true</configHelp>
              <skip>true</skip>
              <skipValidateSpec>true</skipValidateSpec>
<!--              <templateResourcePath>${project.basedir}/src/main/resources/openapi/templates/java-camel</templateResourcePath>-->
<!--              <templateDirectory>${project.basedir}/src/main/resources/openapi/templates</templateDirectory>-->
              <inputSpec>${project.basedir}/src/main/resources/api-core.yaml</inputSpec>

              <generateSupportingFiles>true</generateSupportingFiles>
              <generatorName>java-camel</generatorName>

              <generateApiTests>false</generateApiTests>
              <generateModelTests>false</generateModelTests>
              <generateApiDocumentation>false</generateApiDocumentation>
              <generateModelDocumentation>false</generateModelDocumentation>

              <globalProperties>
<!--                <debugSupportingFiles>true</debugSupportingFiles>-->

              </globalProperties>
              <configOptions>
<!--                <sourceFolder>src/gen/java/main</sourceFolder>-->
<!--                <apiPackage>dev.vsviniciuslima.client.api</apiPackage>-->
<!--                <modelPackage>dev.vsviniciuslima.client.model</modelPackage>-->
<!--                <invokerPackage>dev.vsviniciuslima.client</invokerPackage>-->

                <useLombok>true</useLombok>
                <generateModelTests>false</generateModelTests>
                <useJakartaEe>true</useJakartaEe>
                <dateLibrary>java8</dateLibrary>
                <hideGenerationTimestamp>true</hideGenerationTimestamp>
<!--                <basePackage>${project.groupId}</basePackage>-->
              </configOptions>
<!--              <output>${project.build.directory}/generated-sources/core-client</output>-->
            </configuration>
          </execution>
        </executions>
      </plugin>

      <plugin>
        <groupId>org.apache.camel</groupId>
        <artifactId>camel-component-maven-plugin</artifactId>
        <version>${camel.version}</version>
        <executions>
          <execution>
            <id>generate</id>
            <goals>
              <goal>generate</goal>
            </goals>
            <phase>process-classes</phase>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

</project>
